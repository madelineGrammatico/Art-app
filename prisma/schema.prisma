// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Artwork {
  id    String  @id @default(uuid())
  title String
  price Decimal

  // Données physiques requises pour le devis transporteur (B14 EPIC 0). Nullable :
  // une œuvre existante sans ces valeurs = donnée manquante (≠ 0) → rejet au checkout
  // (US0.2), jamais un calcul à 0 €. Pas de backfill possible (dimension inconnue).
  weightKg Decimal?
  lengthCm Decimal?
  widthCm  Decimal?
  heightCm Decimal?

  // Recalculé à chaque create/update admin à partir des seuils courants (US0.1).
  // Sert UNIQUEMENT à l'affichage admin (US5.1) ; peut devenir stale si la config
  // change → JAMAIS la source de vérité au checkout (recalcul live, cf. spec §2).
  requiresSpecialistCarrier Boolean @default(false)

  ownerId          String?
  owner            User?             @relation(fields: [ownerId], references: [id])
  invoiceLineItems InvoiceLineItem[]
  refundRecoveries RefundRecovery[]
  certificateId    String?           @unique
  certificate      Certificate?
  basketItems      BasketItem[]
  createdAt        DateTime          @default(now())

  @@index([ownerId])
}

model Certificate {
  id        String   @id @default(uuid())
  artworkId String   @unique
  artwork   Artwork? @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  issueDate DateTime
  content   String
}

// Type de pièce comptable (B13 étape 2). SALE = facture de vente, CREDIT_NOTE = avoir.
enum InvoiceType {
  SALE
  CREDIT_NOTE
}

// Mode de remise d'une commande (B14). DELIVERY = livraison transporteur,
// PICKUP = retrait sur place. 1 seul mode par commande (jamais mixte par œuvre).
enum FulfillmentMode {
  DELIVERY
  PICKUP
}

// Nature d'une ligne de facture (B14). ARTWORK = l'œuvre, SHIPPING = son colis.
// 1 œuvre livrée = 2 lignes (ARTWORK + SHIPPING), même artworkId (cf. spec §0).
enum InvoiceLineItemType {
  ARTWORK
  SHIPPING
}

// Compteur séquentiel sans trou pour la numérotation des factures (B13 EPIC 1).
// Incrémenté DANS la transaction qui crée la facture : un rollback annule
// l'incrément (pas de trou) — contrairement à une SEQUENCE Postgres.
// key = "<prefix>:<year>", ex. "INV:2026", "CN:2026".
model Counter {
  key   String @id
  value Int    @default(0)
}

// Facture (SALE) ou avoir (CREDIT_NOTE). Pièce immuable une fois émise (B13).
// 1 facture par commande, détaillée en InvoiceLineItem (≠ ancien 1 invoice/artwork).
model Invoice {
  id       String      @id @default(uuid())
  type     InvoiceType @default(SALE)
  number   String      @unique // séquentiel, attribué à l'émission (cf. numbering.ts)
  issuedAt DateTime    @default(now())
  saleDate DateTime // date de la vente (= paiement) ; pour un avoir = date du remboursement

  buyerId   String
  buyer     User   @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  buyerName String // snapshot identité acheteur figée à l'émission (mention légale obligatoire)

  // Avoir : pointe la facture créditée (null pour une facture de vente).
  creditedInvoiceId String?
  creditedInvoice   Invoice?  @relation("Credits", fields: [creditedInvoiceId], references: [id])
  creditNotes       Invoice[] @relation("Credits")

  stripeSessionId       String?
  stripePaymentIntentId String?
  stripeRefundId        String? // renseigné sur l'avoir (1 avoir / remboursement Stripe)

  // Snapshot vendeur figé à l'émission (source de vérité légale, conservation 10 ans).
  sellerName      String
  sellerLegalForm String
  sellerAddress   String
  sellerSiret     String
  sellerRcs       String?
  sellerVatNumber String?
  vatRegime       String // "FRANCHISE" | "ASSUJETTIE"
  legalMention    String? // ex. "TVA non applicable, art. 293 B du CGI"

  // Snapshot adresses acheteur : FK (navigation, null si supprimée) + snapshot (légal, figé).
  billingAddressId  String?
  billingAddress    PostalAddress? @relation("InvoiceBilling", fields: [billingAddressId], references: [id], onDelete: SetNull)
  billingStreet     String?
  billingPostalCode String?
  billingCity       String?
  billingCountry    String?

  shippingAddressId  String?
  shippingAddress    PostalAddress? @relation("InvoiceShipping", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  shippingStreet     String?
  shippingPostalCode String?
  shippingCity       String?
  shippingCountry    String?

  // Totaux figés (Decimal). Pour un avoir : valeurs négatives.
  totalHT  Decimal
  totalVat Decimal
  totalTTC Decimal

  lineItems InvoiceLineItem[]
  createdAt DateTime          @default(now())

  // Marqueur d'envoi de l'email facture (support durable). null = email non confirmé
  // → rejouable si le webhook a crashé entre le commit et l'envoi (cf. webhook/route.ts).
  emailSentAt DateTime?

  // Mode de remise (B14). @default(DELIVERY) : cohérent pour les factures passées,
  // aucune n'avait de retrait sur place.
  fulfillmentMode FulfillmentMode @default(DELIVERY)

  // Idempotence de l'email de coordination retrait (US1bis.3), même pattern que
  // emailSentAt. null tant que PICKUP n'a pas déclenché l'email ; non pertinent si DELIVERY.
  pickupEmailSentAt DateTime?

  // Conservation 10 ans (US6.2) : aucune suppression dure. Pas de soft-delete dédié
  // (aucun cas métier de « masquage ») → garanti par l'absence d'action de suppression
  // + onDelete: Restrict sur InvoiceLineItem.invoice.

  @@unique([type, stripeSessionId]) // 1 facture de vente / session Stripe
  @@unique([stripeRefundId]) // 1 avoir / remboursement Stripe
  @@index([buyerId])
  @@index([creditedInvoiceId])
  @@index([stripeSessionId])
  @@index([billingAddressId])
  @@index([shippingAddressId])
}

// Une ligne de facture : l'œuvre (ARTWORK) ou son colis (SHIPPING). artworkId reste
// NOT NULL même pour SHIPPING (1 colis = 1 œuvre) → remboursement par œuvre trivial (spec §0).
model InvoiceLineItem {
  id          String              @id @default(uuid())
  invoiceId   String
  invoice     Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  type        InvoiceLineItemType @default(ARTWORK) // @default : lignes B13 existantes = ARTWORK
  artworkId   String
  artwork     Artwork             @relation(fields: [artworkId], references: [id])
  label       String // snapshot du titre de l'œuvre / libellé transporteur à l'émission
  unitPriceHT Decimal
  quantity    Int                 @default(1)
  vatRate     Decimal // 0 en franchise, ex. 0.055 en assujetti 5,5 %
  vatAmount   Decimal
  lineTTC     Decimal

  // Renseignés uniquement quand type = SHIPPING :
  shippingMethodId       String? // service transporteur retenu au devis (ex. id Sendcloud)
  shippingParcelId       String? // colis créé chez le transporteur — idempotence EPIC 3bis
  shippingParcelFailedAt DateTime? // échec de création post-paiement → alerte admin

  @@unique([invoiceId, artworkId, type]) // autorise les 2 lignes (ARTWORK + SHIPPING) par œuvre
  @@index([artworkId])
}

// Marqueur de récupération pour le remboursement « race au checkout » (œuvre déjà
// vendue) : aucune vente n'a eu lieu → pas de facture. stripeRefundId null = à rejouer.
model RefundRecovery {
  id              String   @id @default(uuid())
  stripeSessionId String
  buyerId         String
  buyer           User     @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  artworkId       String
  artwork         Artwork  @relation(fields: [artworkId], references: [id])
  amount          Decimal
  stripeRefundId  String? // null = remboursement non confirmé (marqueur de récupération)
  createdAt       DateTime @default(now())

  @@unique([stripeSessionId, artworkId])
  @@index([stripeSessionId])
  @@index([buyerId])
}

enum UserRole {
  ADMIN
  CLIENT
}

model User {
  id            String    @id @default(uuid())
  name          String?
  lastName      String?
  firstName     String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(CLIENT)

  invoices            Invoice[]
  refundRecoveries    RefundRecovery[]
  artworks            Artwork[]
  passwordResetTokens PasswordResetToken[]
  accounts            Account[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  postalAddresses     PostalAddress[]
  basket              Basket?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id      String   @id @default(uuid())
  token   String   @unique
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  expires DateTime
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expireAt  DateTime
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PostalAddress {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street            String
  postalCode        String
  city              String
  country           String
  isDefaultBilling  Boolean  @default(false)
  isDefaultShipping Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  billingInvoices  Invoice[] @relation("InvoiceBilling")
  shippingInvoices Invoice[] @relation("InvoiceShipping")

  @@index([userId])
}

model Basket {
  id        String       @id @default(uuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     BasketItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
}

model BasketItem {
  id        String   @id @default(uuid())
  basketId  String
  basket    Basket   @relation(fields: [basketId], references: [id], onDelete: Cascade)
  artworkId String
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([basketId, artworkId])
  @@index([basketId])
  @@index([artworkId])
}

